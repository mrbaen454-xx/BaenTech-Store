# Product Service
# Copy this file to .env for local development.

# Render/Koyeb/HF Spaces may set PORT automatically.
# PORT=8082
PRODUCT_SERVICE_PORT=8082

PRODUCT_DB_URL=jdbc:postgresql://localhost:5432/baentech_product_db
PRODUCT_DB_USERNAME=postgres
PRODUCT_DB_PASSWORD=

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
ACTUATOR_EXPOSURE=*

MULTIPART_ENABLED=true
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=5MB

INTERNAL_API_KEY=
