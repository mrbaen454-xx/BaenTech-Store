# Payment Service
# Copy this file to .env for local development.

# Render/Koyeb/HF Spaces may set PORT automatically.
# PORT=8086
PAYMENT_SERVICE_PORT=8086

PAYMENT_DB_URL=jdbc:postgresql://localhost:5432/baentech_payment_db
PAYMENT_DB_USERNAME=postgres
PAYMENT_DB_PASSWORD=

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
ACTUATOR_EXPOSURE=*

XENDIT_SECRET_KEY=
XENDIT_CALLBACK_TOKEN=
XENDIT_INVOICE_URL=https://api.xendit.co/v2/invoices

APP_FRONTEND_URL=http://localhost:5173

INTERNAL_API_KEY=
ORDER_SERVICE_URL=http://ORDER-SERVICE
