# Shipping Service
# Copy this file to .env for local development.

# Render/Koyeb/HF Spaces may set PORT automatically.
# PORT=8087
SHIPPING_SERVICE_PORT=8087

SHIPPING_DB_URL=jdbc:postgresql://localhost:5432/baentech_shipping_db
SHIPPING_DB_USERNAME=postgres
SHIPPING_DB_PASSWORD=

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
ACTUATOR_EXPOSURE=*
