# Order Service
# Copy this file to .env for local development.

# Render/Koyeb/HF Spaces may set PORT automatically.
# PORT=8085
ORDER_SERVICE_PORT=8085

ORDER_DB_URL=jdbc:postgresql://localhost:5432/baentech_order_db
ORDER_DB_USERNAME=postgres
ORDER_DB_PASSWORD=

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
ACTUATOR_EXPOSURE=*

INTERNAL_API_KEY=
PRODUCT_SERVICE_URL=http://PRODUCT-SERVICE
