# Auth Service
# Copy this file to .env for local development.

# Render/Koyeb/HF Spaces may set PORT automatically.
# PORT=8081
AUTH_SERVICE_PORT=8081

AUTH_DB_URL=jdbc:postgresql://localhost:5432/baentech_auth_db
AUTH_DB_USERNAME=postgres
AUTH_DB_PASSWORD=

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
ACTUATOR_EXPOSURE=*

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

APP_FRONTEND_URL=http://localhost:5173
