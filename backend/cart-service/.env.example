# Cart Service
# Copy this file to .env for local development.

# Render/Koyeb/HF Spaces may set PORT automatically.
# PORT=8084
CART_SERVICE_PORT=8084

CART_DB_URL=jdbc:postgresql://localhost:5432/baentech_cart_db
CART_DB_USERNAME=postgres
CART_DB_PASSWORD=

JPA_DDL_AUTO=update
JPA_SHOW_SQL=true
JPA_FORMAT_SQL=true

EUREKA_DEFAULT_ZONE=http://localhost:8761/eureka/
ACTUATOR_EXPOSURE=*
